      m_Calls: []
  m_text: "1. \u0412 \u043C\u0430\u0448\u0438\u043D\u0435 \u0440\u0435\u0430\u043B\u0438\u0437\u043E\u0432\u0430\u043D\u0430
    \u043C\u0435\u0445\u0430\u043D\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u043A\u043E\u0440\u043E\u0431\u043A\u0430
    \u043F\u0435\u0440\u0435\u0434\u0430\u0447. \u0414\u043B\u044F \u0442\u043E\u0433\u043E
    \u0447\u0442\u043E\u0431\u044B \u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F
    \u043D\u0430\u0437\u0430\u0434 \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E
    \u0432\u043A\u043B\u044E\u0447\u0438\u0442\u044C \u0437\u0430\u0434\u043D\u044E\u044E
    \u043F\u0435\u0440\u0435\u0434\u0430\u0447\u0443 \u0438 \u043D\u0430\u0436\u0430\u0442\u044C
    \u043F\u0435\u0434\u0430\u043B\u044C \u0433\u0430\u0437\u0430.\n\n2. \u0412 \u043C\u0430\u0448\u0438\u043D\u0435
    \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u043E \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0435
    \u0441\u0446\u0435\u043F\u043B\u0435\u043D\u0438\u0435, \u0432\u044B\u0436\u0438\u043C\u0430\u0442\u044C
    \u0441\u0446\u0435\u043F\u0443 \u043D\u0435\u0442 \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E\u0441\u0442\u0438,
    \u044D\u0442\u043E \u043D\u0438 \u043D\u0430 \u0447\u0442\u043E \u043D\u0435
    \u043F\u043E\u0432\u043B\u0438\u044F\u0435\u0442.\n\n3."
