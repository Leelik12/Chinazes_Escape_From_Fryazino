    \u0432\u043A\u043B\u044E\u0447\u0438\u0442\u044C \u0437\u0430\u0434\u043D\u044E\u044E
    \u043F\u0435\u0440\u0435\u0434\u0430\u0447\u0443 \u0438 \u043D\u0430\u0436\u0430\u0442\u044C
    \u043F\u0435\u0434\u0430\u043B\u044C \u0433\u0430\u0437\u0430.\n\n2. \u0427\u0442\u043E\u0431\u044B
    \u043F\u0435\u0440\u0435\u043A\u043B\u044E\u0447\u0438\u0442\u044C \u043F\u0435\u0440\u0435\u0434\u0430\u0447\u0443,
    \u0432\u044B\u0436\u043C\u0438\u0442\u0435 \u0441\u0446\u0435\u043F\u0443 \u0438
    \u0432\u043A\u043B\u044E\u0447\u0438\u0442\u0435 \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u0443\u044E
    \u043F\u0435\u0440\u0435\u0434\u0430\u0447\u0443. \u0417\u0430\u0434\u043D\u044F\u044F
